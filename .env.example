# Store admin dashboard PIN for /admin (default: 1234)
ADMIN_PIN=1234

# Phone number or National ID / Tax ID used to generate Dynamic PromptPay QR
PROMPTPAY_ID=0891234567

# Public HTTPS base URL of your site (required for LINE to display uploaded payment slip images)
PUBLIC_BASE_URL=https://your-domain.com

# LINE Messaging API configuration (Stateless Channel Access Token) for automatic order notifications
# 1. Create a Messaging API Channel in the LINE Developers Console (https://developers.line.biz/)
# 2. Copy the Channel ID and Channel secret from the Basic settings tab into LINE_CHANNEL_ID and LINE_CHANNEL_SECRET
# 3. Set LINE_TARGET_ID to the store owner's User ID (starts with U...) or store Group ID (starts with C...)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_TARGET_ID=
